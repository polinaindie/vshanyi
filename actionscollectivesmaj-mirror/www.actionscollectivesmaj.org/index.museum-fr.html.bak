r",type:"Link",linkType:"Environment"}},publishedVersion:6,revision:3,contentType:{sys:{type:"Link",linkType:"ContentType",id:"lien"}},locale:"fr-CA"},fields:{titre:"Crédits",route:"/pages/credits"}},{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"7nBA47hLfbuwbXb3JOLMtM",type:"Entry",createdAt:"2024-03-05T22:13:40.576Z",updatedAt:"2025-05-09T20:27:06.943Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:4,revision:2,contentType:{sys:{type:"Link",linkType:"ContentType",id:"lien"}},locale:"fr-CA"},fields:{titre:"Commentaires",route:"/commentaires"}},{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"2SRQsCJKgCTHh6y9QxepNB",type:"Entry",createdAt:"2024-05-02T19:08:24.054Z",updatedAt:"2026-07-09T14:01:27.882Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:16,revision:7,contentType:{sys:{type:"Link",linkType:"ContentType",id:"lien"}},locale:"fr-CA"},fields:{titre:"Politique de confidentialité",route:"https://www.museejoliette.org/politique-de-confidentialite",externe:true}}]}},locale:"fr"},uses:{}},(function(a,b,c){a.metadata={tags:[],concepts:[]};a.sys={space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"3CnItdHLMNqjKni8ZoMZUB",type:"Asset",createdAt:"2025-03-04T18:30:16.850Z",updatedAt:"2025-04-29T14:57:04.721Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:12,revision:5,locale:"fr-CA"};a.fields={title:"POL1978 OE",description:"Douze tirages photographiques disposés en grille, dans lesquels une personne vêtue de rouge court à travers un entrepôt désert. L’arrière-plan et le cadrage restent constants, alors que la figure devient de plus en plus floue jusqu’à disparaître. (Sorel Cohen – The Camera Can Obliterate the Reality it Records, 1978 – Épreuve à développement chromogène)",file:{url:"img/01-5283260441159654282_121.jpg",details:{size:753014,image:{width:1172,height:857}},fileName:"POL1978_OE.jpg",contentType:"image/jpeg"}};b.metadata={tags:[],concepts:[]};b.sys={space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"65dqoG4RNps9E0oIA4qOGV",type:"Asset",createdAt:"2025-03-04T18:32:13.819Z",updatedAt:"2025-04-29T14:57:36.180Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:8,revision:4,locale:"fr-CA"};b.fields={title:"MAJ1960 OE",description:"Peinture abstraite composée de taches empâtées, dans des tons de vert et de noir. Des coups de spatule et des éclats de blanc et de jaune ajoutent un caractère spontané à la composition structurée. (Rita Letendre – Étincelles, 1959 – Huile sur toile)",file:{url:"//downloads.ctfassets.net/nbfcd3ddu3u4/65dqoG4RNps9E0oIA4qOGV/2319ea097b4cb520dc596aeab095523c/MAJ1960_OE.jpg",details:{size:22770055,image:{width:7136,height:3697}},fileName:"MAJ1960_OE.jpg",contentType:"image/jpeg"}};c.metadata={tags:[],concepts:[]};c.sys={space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"1ir2TWA0faB59KmmVoXLga",type:"Asset",createdAt:"2025-03-04T18:30:16.865Z",updatedAt:"2025-04-29T14:58:22.056Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:6,revision:3,locale:"fr-CA"};c.fields={title:"POL2009 OE",description:"Paysage texturé montrant une écluse et des personnages en veston sur un ponton dans un camaïeu de brun et de vert. Des arbres occupent les deux tiers supérieurs, laissant filtrer une lumière diffuse. (Berthe Des Clayes – L’écluse, n.d. – Huile sur carton)",file:{url:"img/03-4O1A5411.jpg",details:{size:13903449,image:{width:5335,height:4656}},fileName:"POL2009_OE.jpg",contentType:"image/jpeg"}};return {type:"data",data:{page:{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"2pHmaSOJrTjZfNcc5DnAlj",type:"Entry",createdAt:"2024-02-12T17:24:31.357Z",updatedAt:"2025-05-21T16:20:24.314Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:164,revision:34,contentType:{sys:{type:"Link",linkType:"ContentType",id:"page"}},locale:"fr-CA"},fields:{titre:"Accueil",id:"accueil",description:"Visite virtuelle de l'exposition Actions collectives. Regards féministes sur la collection du Musée d'art de Joliette. Des entrevues vidéo avec des intervenantes mettent les visiteurs en contexte. ",contenu:[{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"1U8FsN84euMS5Ogq8GayzZ",type:"Entry",createdAt:"2024-02-12T17:24:48.439Z",updatedAt:"2025-04-01T18:25:17.781Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:21,revision:8,contentType:{sys:{type:"Link",linkType:"ContentType",id:"gallerie"}},locale:"fr-CA"},fields:{titre:"Galerie 1",id:"gallerie-1",oeuvres:[{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"QkqIvNl69Z7BGKbRyJUgP",type:"Entry",createdAt:"2024-05-21T16:33:30.473Z",updatedAt:"2025-06-08T21:01:17.463Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:328,revision:103,contentType:{sys:{type:"Link",linkType:"ContentType",id:"oeuvre"}},locale:"fr-CA"},fields:{titre:"The Camera Can Obliterate the Reality it&nbsp;Records",id:"the-camera-can-obliterate-the-reality-it-records",descriptionSearch:"Dès ses débuts, l'artiste Sorel Cohen participe à des expositions féministes au Québec. La séquence d'autoportraits est essentielle à sa pratique d'oeuvres photographiques. ",numero:"1996.019",description:"\u003Cem> Art et féminisme\u003C/em> au&nbsp;Musée d’art contemporain de&nbsp;Montréal",artiste:{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"19ruKqp7kRz5DRoILaNclr",type:"Entry",createdAt:"2024-05-16T16:17:11.526Z",updatedAt:"2025-05-27T19:43:27.145Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:9,revision:5,contentType:{sys:{type:"Link",linkType:"ContentType",id:"artiste"}},locale:"fr-CA"},fields:{nom:"Sorel Cohen",id:"cohen--sorel",nomFamille:"Cohen",prenom:"Sorel",lieuDeNaissance:"Montréal, Québec",anneeDeNaissance:1936}},anneeDentreeAuMusee:1996,anneeEvenement:1978,annee:1978,anneeDeRealisation:"1978",vignette:a,media:[a],fiche:{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"1rsJiTHgsuqinSIDzmri5G",type:"Asset",createdAt:"2025-05-16T15:36:41.324Z",updatedAt:"2025-06-02T16:06:57.094Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:6,revision:2,locale:"fr-CA"},fields:{title:"POL actions-collectives fiches 1978",description:"",file:{url:"//assets.ctfassets.net/nbfcd3ddu3u4/1rsJiTHgsuqinSIDzmri5G/6521303fc442b3b76f0f0a83b219442a/POL_actions-collectives_fiches_1978.pdf",details:{size:102717},fileName:"POL_actions-collectives_fiches_1978.pdf",contentType:"application/pdf"}}},format:"Moyen",hauteur:68.5,largeur:55.7,typologie:"photographie",medium:"Épreuve à développement chromogène, 15/100",droits:"© Sorel Cohen / CARCC Ottawa 2025.\nPhoto : Stéfanie Meunier.",mention:"Don de Luc LaRochelle",corps:{data:{},content:[{data:{},content:[{data:{},marks:[],value:"Sorel Cohen se distingue dans le milieu de l’art montréalais dès les années&nbsp;1970, comptant parmi les premières artistes à adopter une démarche photographique féministe et conceptuelle. Ayant étudié en peinture à la Sir&nbsp;George Williams University (aujourd’hui l’Université Concordia), elle se tourne vers la photographie et l’autoportrait afin d’entamer une exploration introspective de sa propre condition de femme",nodeType:"text"},{data:{},marks:[{type:"superscript"}],value:"1",nodeType:"text"},{data:{},marks:[],value:". À la fois artiste et modèle, sujet et objet, elle se sert de l’aspect performatif de la photographie pour interroger la condition des femmes dans la société actuelle et les codes de l’histoire de l’art occidental qui leur confèrent un statut&nbsp;subordonné",nodeType:"text"},{data:{},marks:[{type:"superscript"}],value:"2",nodeType:"text"},{data:{},marks:[],value:".  ",nodeType:"text"}],nodeType:"paragraph"},{data:{},content:[{data:{},marks:[],value:"Tôt dans sa carrière, Sorel Cohen participe à deux expositions d’envergure rassemblant la production d’artistes québécoises. La première, ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"ArtFemme",nodeType:"text"},{data:{},marks:[],value:"&nbsp;'",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"75",nodeType:"text"},{data:{},marks:[],value:" est tenue en&nbsp;1975 à l’occasion de l’Année internationale de la femme dans trois lieux en simultané&nbsp;: le Centre Saidye Bronfman, le Musée d’art contemporain de Montréal&nbsp;(MAC) et la Centrale Galerie Powerhouse, troisième lieu consacré à la diffusion de l’art des femmes ouvert l’année&nbsp;précédente. ",nodeType:"text"}],nodeType:"paragraph"},{data:{target:{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"XqEzO3oW83jTzbTX1MuzZ",type:"Asset",createdAt:"2025-04-03T14:07:30.647Z",updatedAt:"2025-05-29T16:16:55.251Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:36,revision:11,locale:"fr-CA"},fields:{title:"Affiche en noir et blanc montrant une grande poupée en tissu, assise sur une chaise devant plusieurs tableaux encadrés et posés contre le mur. L'affiche présente le titre de l'exposition «ArtFemme '75», les lieux de l'exposition et l'heure du vernissage. ",description:"Affiche de l'exposition \u003Cem>ArtFemme&nbsp;'75\u003C/em>, présentée au Musée d’art contemporain de Montréal du 3&nbsp;avril au 25&nbsp;avril&nbsp;1975. Archives du Musée d’art contemporain de&nbsp;Montréal.",file:{url:"img/07-IMG_2729.jpg",details:{size:824596,image:{width:1610,height:2485}},fileName:"POL1978_MAC_AF1975.13_IN1b.jpg",contentType:"image/jpeg"}}}},content:[],nodeType:"embedded-asset-block"},{data:{},content:[{data:{},marks:[{type:"italic"}],value:"ArtFemme",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"’75",nodeType:"text"},{data:{},marks:[],value:" met en évidence la contribution des femmes afin de l’inclure dans l’historicité, diffusant&nbsp;150 œuvres de 94&nbsp;artistes contemporaines",nodeType:"text"},{data:{},marks:[{type:"superscript"}],value:"3",nodeType:"text"},{data:{},marks:[],value:". Elle est suivie par l’exposition ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Art et féminisme",nodeType:"text"},{data:{},marks:[],value:", présentée au&nbsp;MAC en&nbsp;1982. La&nbsp;commissaire de cette deuxième exposition, Rose-Marie Arbour, mise non seulement sur un art fait par des femmes, mais sur un art véritablement féministe, distinction apportée par Thérèse St-Gelais dans le catalogue de&nbsp;l’exposition",nodeType:"text"},{data:{},marks:[{type:"superscript"}],value:"4",nodeType:"text"},{data:{},marks:[],value:".",nodeType:"text"}],nodeType:"paragraph"},{data:{},content:[{data:{},marks:[],value:"Lors de l’exposition ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Art et féminisme",nodeType:"text"},{data:{},marks:[],value:", Cohen expose deux de ses premières œuvres photographiques, ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Le",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"rite matinal",nodeType:"text"},{data:{},marks:[],value:"&nbsp;(1977) et ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"The Shape of Gesture",nodeType:"text"},{data:{},marks:[],value:"&nbsp;(1978). Celles-ci consistent en des séquences d’autoportraits dans lesquelles l’artiste réalise des tâches ménagères, évoquant leur caractère répétitif et banal auquel sont confrontées les femmes au foyer. Elle capte ses mouvements à l’aide d’une longue exposition et d’une vitesse d’obturation lente, les transformant en des taches de couleur floues et informes. Disposant les images générées en grille, elle reprend les références formelles du modernisme et détourne leur association à une histoire de l’art entièrement définie par les&nbsp;hommes.",nodeType:"text"}],nodeType:"paragraph"},{data:{},content:[{data:{},marks:[],value:"À la même époque et à partir d’une technique similaire, elle crée ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"The",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Camera Can Obliterate the Reality it Records",nodeType:"text"},{data:{},marks:[],value:", une œuvre dont le thème n’est pas lié à la sphère domestique. Dans une séquence de douze images, l’artiste court, vêtue d’un rouge brillant, et la trace de son corps en mouvement disparaît progressivement, tandis que le fond et le cadrage restent&nbsp;fixes. ",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"document"},historique:{data:{},content:[{data:{},content:[{data:{},marks:[],value:"Édition photographique du&nbsp;MAJ&nbsp;(15/100) : ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Féminin pluriel. 16",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"artistes de la collection du",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"MAJ",nodeType:"text"},{data:{},marks:[],value:", Musée d’art de Joliette, Joliette (Québec), du 23&nbsp;mai au 29&nbsp;août&nbsp;2010&nbsp;; ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Eadweard Muybridge",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:": L’intuition du photographe",nodeType:"text"},{data:{},marks:[],value:", Musée d’art de Joliette, Joliette (Québec), du 20&nbsp;mai au 2&nbsp;septembre&nbsp;2007 ; ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Une expérience de l’art du siècle",nodeType:"text"},{data:{},marks:[],value:", Musée d’art de Joliette, Joliette (Québec), du 26&nbsp;mai au 1",nodeType:"text"},{data:{},marks:[{type:"superscript"}],value:"er",nodeType:"text"},{data:{},marks:[],value:"&nbsp;octobre&nbsp;2000.",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"document"},credits:{data:{},content:[{data:{},content:[{data:{},content:[{data:{},content:[{data:{},marks:[],value:"Dot Tuer, «&nbsp;La persistance de la mémoire dans la pratique photographique de Sorel Cohen&nbsp;», dans ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Sorel Cohen",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:": Métaphores conceptuelles/Conceptual Metaphors",nodeType:"text"},{data:{},marks:[],value:", dir.&nbsp;Marie-Josée Jean (Montréal&nbsp;: VOX, centre de l’image contemporaine, 2022), 145-146. ",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"list-item"},{data:{},content:[{data:{},content:[{data:{},marks:[],value:"Marie-Josée Jean, «&nbsp;Montrer le faire&nbsp;», dans ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Sorel Cohen",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:": Métaphores conceptuelles/Conceptual Metaphors",nodeType:"text"},{data:{},marks:[],value:", dir.&nbsp;Marie-Josée Jean (Montréal&nbsp;: VOX, centre de l’image contemporaine, 2022), 14.",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"list-item"},{data:{},content:[{data:{},content:[{data:{},marks:[],value:"Fernande Saint-Martin et Gail Lauzzana, ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"ArtFemme",nodeType:"text"},{data:{},marks:[],value:"&nbsp;'",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"75",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:": Une exposition d'œuvres de femmes artistes/An Exhibition of Women's Art",nodeType:"text"},{data:{},marks:[],value:" (Montréal&nbsp;: Centre Saidye Bronfman/Musée d'art contemporain de Montréal/Galerie Powerhouse/YMCA, 1975).",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"list-item"},{data:{},content:[{data:{},content:[{data:{},marks:[],value:"Thérèse St-Gelais, «&nbsp;Remarques sur l’art féminin et l’art féministe&nbsp;», dans ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Art et féminisme",nodeType:"text"},{data:{},marks:[],value:", dir.&nbsp;Rose-Marie Arbour (Montréal&nbsp;: Musée d’art contemporain, 1982), 146-153. ",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"list-item"}],nodeType:"ordered-list"},{data:{},content:[{data:{},marks:[],value:"",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"document"}}},{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"6UK6GCiIREE4Z0mBvOnNVp",type:"Entry",createdAt:"2024-05-21T16:27:15.130Z",updatedAt:"2025-06-06T14:52:02.957Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:332,revision:79,contentType:{sys:{type:"Link",linkType:"ContentType",id:"oeuvre"}},locale:"fr-CA"},fields:{titre:"Étincelles",id:"etincelles",descriptionSearch:"Le tableau Étincelles de Rita Letendre est l'une des premières oeuvres abstraites acquises par le Musée d'art de Joliette. Plusieurs de ses oeuvres ont enrichi la collection. ",numero:"2012.108",description:"Investir dans l’abstraction",artiste:{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"3EKUC789gJ9NwMtD1IoJue",type:"Entry",createdAt:"2024-05-16T16:17:00.615Z",updatedAt:"2025-05-27T14:14:49.609Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:11,revision:5,contentType:{sys:{type:"Link",linkType:"ContentType",id:"artiste"}},locale:"fr-CA"},fields:{nom:"Rita Letendre",id:"letendre--rita",nomFamille:"Letendre",prenom:"Rita",lieuDeNaissance:"Drummondville, Québec",anneeDeNaissance:1928,lieuDeDeces:"Toronto, Ontario",anneDeDeces:2021}},anneeDentreeAuMusee:1960,anneeEvenement:1960,annee:1959,anneeDeRealisation:"1959",vignette:b,media:[b],fiche:{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"10mSa9e6pW3EGzQF84c02N",type:"Asset",createdAt:"2025-05-16T14:50:05.565Z",updatedAt:"2025-06-02T15:47:10.230Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:6,revision:2,locale:"fr-CA"},fields:{title:"MAJ actions-collectives fiches 1960",description:"",file:{url:"//assets.ctfassets.net/nbfcd3ddu3u4/10mSa9e6pW3EGzQF84c02N/d6adfde55cb31dc08ee87050f5b78030/MAJ_actions-collectives_fiches_1960.pdf",details:{size:103823},fileName:"MAJ_actions-collectives_fiches_1960.pdf",contentType:"application/pdf"}}},format:"Petit",hauteur:153.9,largeur:82.2,typologie:"peinture",medium:"Huile sur toile",droits:"© Succession Rita Letendre. \nPhoto : Lucie Rocher. ",mention:"Collection Wilfrid Corbeil. Don des Clercs de Saint-Viateur du Canada",corps:{data:{},content:[{data:{},content:[{data:{},marks:[],value:"Au cours des premières décennies du Musée d’art de Joliette, le développement de la collection demeure intimement lié aux champs d’intérêt du père Wilfrid Corbeil, c.s.v., qui assure la direction et la présidence du conseil d’administration jusqu’en&nbsp;1977. À partir d’une poignée d’acquisitions en&nbsp;1943, la collection s’enrichit progressivement, entre autres, grâce aux dons d'anciens élèves du Séminaire et d'artistes qui y ont&nbsp;exposé. ",nodeType:"text"}],nodeType:"paragraph"},{data:{},content:[{data:{},marks:[],value:"Le père Corbeil s’intéresse aux recherches formelles menées par les artistes de l’époque, que ce soit dans les sphères de l’art profane ou de l’art sacré, et s’engage souvent dans des discussions sur les mérites de l’art actuel",nodeType:"text"},{data:{},marks:[{type:"superscript"}],value:"1",nodeType:"text"},{data:{},marks:[],value:". Cet intérêt se manifeste également dans sa collection personnelle, avec ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Étincelles",nodeType:"text"},{data:{},marks:[],value:", qu’il achète directement de l’artiste Rita Letendre en&nbsp;1960. ",nodeType:"text"}],nodeType:"paragraph"},{data:{},content:[{data:{},marks:[],value:"Figure de proue de l’art non figuratif au Québec, Rita Letendre se fait connaître à un moment où le milieu artistique montréalais se distancie de la vision unifiée du groupe automatiste, priorisant dorénavant la vision individuelle de l’artiste moderne",nodeType:"text"},{data:{},marks:[{type:"superscript"}],value:"2",nodeType:"text"},{data:{},marks:[],value:". Née à Drummondville en&nbsp;1928, elle entame des études à l’École des beaux-arts de Montréal en&nbsp;1949. Elle quitte toutefois l'établissement après deux ans, inspirée par cet élan de rupture qui alimente ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"L’exposition des rebelles",nodeType:"text"},{data:{},marks:[{type:"superscript"}],value:"3",nodeType:"text"},{data:{},marks:[],value:". Organisée par les automatistes, cette manifestation qu’elle visite en 1949 se dresse en opposition du ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Salon du",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"printemps",nodeType:"text"},{data:{},marks:[],value:", exposition annuelle consacrée à la pratique canadienne, tenue au Musée des beaux-arts de Montréal depuis&nbsp;1880. En&nbsp;1954, Letendre participe à la dernière exposition automatiste, ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"La",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"matière",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"chante",nodeType:"text"},{data:{},marks:[],value:". Elle tient sa première exposition solo l’année suivante à la galerie&nbsp;L’Échouerie.",nodeType:"text"}],nodeType:"paragraph"},{data:{},content:[{data:{},marks:[],value:"Composée de taches empâtées sous une impulsion spontanée, ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Étincelles",nodeType:"text"},{data:{},marks:[],value:" confirme l’intégration de la figure et du fond dans un traitement global de la surface, approche picturale que Letendre développe au début des années&nbsp;1960. Le mouvement animé de la spatule ainsi que les éclats de couleur ajoutent une expressivité certaine à ce tableau&nbsp;sombre. ",nodeType:"text"}],nodeType:"paragraph"},{data:{},content:[{data:{},marks:[],value:"Près de cinquante ans après l’achat de l’œuvre par le père Corbeil, réalisé dans l’objectif de compléter le corpus de l’artiste constitué au fil des décennies, le fils de la peintre et la conjointe de celui-ci font don d’une sélection d’œuvres réfléchie de pair avec l’équipe du Musée. La collection reflète désormais le parcours de Rita Letendre sur un demi-siècle de production, de l’abstraction gestuelle au ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"hard",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"edge",nodeType:"text"},{data:{},marks:[],value:", à travers sa production picturale, sérigraphique et, étonnamment, en tapisserie avec une œuvre inédite dans son&nbsp;parcours. ",nodeType:"text"}],nodeType:"paragraph"},{data:{target:{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"7LikztXl7Oadpc7crACrSh",type:"Asset",createdAt:"2025-05-13T14:13:34.185Z",updatedAt:"2025-05-23T16:47:06.299Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:38,revision:7,locale:"fr-CA"},fields:{title:"Photographie couleur d’une galerie de musée aux murs foncés, où sont visibles des tableaux abstraits colorés et une tapisserie du même style. ",description:"Vue de l'exposition \u003Cem>Rita Letendre. Tableaux tumultueux\u003C/em> au Musée d'art de Joliette, 2022,  présentant des œuvres de la collection du Musée. À gauche, les tableaux \u003Cem>Influx\u003C/em> (1968) et \u003Cem>Sans titre nᵒ&nbsp;16\u003C/em>  (1966) illustrent la technique \u003Cem>hard-egde\u003C/em>, tandis qu'à droite, on aperçoit la tapisserie \u003Cem>Koohiaak\u003C/em>  (1976). Photo&nbsp;: Paul Litherland.",file:{url:"img/08-IMG_3431.jpg",details:{size:565617,image:{width:2000,height:1333}},fileName:"MAJ1960-Letendre_Litherland.jpg",contentType:"image/jpeg"}}}},content:[],nodeType:"embedded-asset-block"},{data:{},content:[{data:{},marks:[],value:"",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"document"},historique:{data:{},content:[{data:{},content:[{data:{},marks:[{type:"italic"}],value:"Rita Letendre. Tableaux tumultueux",nodeType:"text"},{data:{},marks:[],value:", Musée d’art de Joliette, Joliette (Québec), du&nbsp;15&nbsp;octobre&nbsp;2022 au&nbsp;15&nbsp;janvier&nbsp;2023&nbsp;; ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Les siècles de l’image. La collection permanente, du 15",nodeType:"text"},{data:{},marks:[{type:"italic"},{type:"superscript"}],value:"e",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"siècle à nos jours",nodeType:"text"},{data:{},marks:[],value:", Musée d’art de Joliette, Joliette (Québec), du 2&nbsp;décembre&nbsp;2012 au&nbsp;1",nodeType:"text"},{data:{},marks:[{type:"superscript"}],value:"er",nodeType:"text"},{data:{},marks:[],value:"&nbsp;février&nbsp;2013&nbsp;; ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Parcours d’une collection",nodeType:"text"},{data:{},marks:[],value:", Musée d’art de Joliette, Joliette (Québec), du&nbsp;18&nbsp;juin&nbsp;1992 au&nbsp;2&nbsp;avril&nbsp;2008&nbsp;; ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"L’école des femmes",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:": 50",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"artistes canadiennes au Musée",nodeType:"text"},{data:{},marks:[],value:", Musée d’art de Joliette, Joliette (Québec), du&nbsp;7&nbsp;septembre&nbsp;2003 au&nbsp;22&nbsp;février&nbsp;2004&nbsp;; ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Peinture-Peinture",nodeType:"text"},{data:{},marks:[],value:", événement organisé par l’Association des galeries d’art contemporain de Montréal, Musée d’art de Joliette, Joliette (Québec), du&nbsp;6&nbsp;juin au&nbsp;11&nbsp;juillet&nbsp;1998&nbsp;; Musée d’art de Saint-Laurent, Saint-Laurent (Québec), du&nbsp;9&nbsp;septembre au&nbsp;12&nbsp;novembre&nbsp;1982&nbsp;; Salle canadienne, collection permanente, Musée d’art de Joliette, Joliette (Québec), à partir de juillet&nbsp;1980.",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"document"},publications:{data:{},content:[{data:{},content:[{data:{},marks:[],value:"Gaëtane Verna et&nbsp;coll., ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Le Musée d’art de Joliette",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:": Catalogue des collections",nodeType:"text"},{data:{},marks:[],value:" (Joliette&nbsp;: Musée d’art de Joliette, 2012), cat.&nbsp;15, 112-113&nbsp;; France Gascon et Pascale Champagne,&nbsp;dir., ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"L’école des femmes",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:": 50",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"artistes canadiennes au Musée. Guide d’exposition",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"/ The School of Women: 50",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Canadian Artists at the Museum. Guidebook to the Exhibit",nodeType:"text"},{data:{},marks:[],value:" (Joliette&nbsp;: Musée d’art de Joliette, 2003),&nbsp;37-38&nbsp;; Wilfrid Corbeil,&nbsp;c.s.v., ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Le Musée d’art de Joliette",nodeType:"text"},{data:{},marks:[],value:" (Joliette&nbsp;: Musée d’art de Joliette, 1971), cat.&nbsp;395, 13, 271,&nbsp;pl. XII.",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"document"},credits:{data:{},content:[{data:{},content:[{data:{},content:[{data:{},content:[{data:{},marks:[],value:"Manuel Maitre, «&nbsp;Artiste-peintre et collectionneur enragé, le père Corbeil est nommé conservateur du nouveau Musée d’art de Joliette&nbsp;», ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"La",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Patrie",nodeType:"text"},{data:{},marks:[],value:", 25&nbsp;mai&nbsp;1969. ",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"list-item"},{data:{},content:[{data:{},content:[{data:{},marks:[],value:"Denise Leclerc, ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"La crise de l’abstraction au Canada",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:": Les années 1950",nodeType:"text"},{data:{},marks:[],value:" (Ottawa&nbsp;: Musée des beaux-arts du Canada,&nbsp;1992).",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"list-item"},{data:{},content:[{data:{},content:[{data:{},marks:[],value:"Sandra Paikowsky, ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Rita Letendre",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:": The Montreal Years, 1953-1963",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"/ Les années montréalaises, 1953-1963 ",nodeType:"text"},{data:{},marks:[],value:"(Montréal&nbsp;: Galerie d’art Concordia,&nbsp;1989). ",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"list-item"}],nodeType:"ordered-list"},{data:{},content:[{data:{},marks:[],value:"",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"document"},creditsFiches:"Rita Letendre, Étincelles, 1959, huile sur toile, 82,2 cm x 153,9 cm. Collection Wilfrid Corbeil. Don des Clercs de Saint-Viateur du Canada, 2012.108. © Succession Rita Letendre. Photo : Lucie Rocher."}},{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"7AjesChpCQpyAVvzyLlma1",type:"Entry",createdAt:"2025-03-04T20:49:33.216Z",updatedAt:"2025-06-03T17:38:54.006Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:284,revision:69,contentType:{sys:{type:"Link",linkType:"ContentType",id:"oeuvre"}},locale:"fr-CA"},fields:{titre:"L'écluse",id:"l-ecluse",descriptionSearch:"L'exposition Femmes artistes du 20e siècle au Québec présentée au Musée national des beaux-arts du Québec a mis en valeur l'art des femmes, dont les oeuvres de l'artiste Berthe Des Clayes.",numero:"1990.035",description:"\u003Cem>Femmes artistes du&nbsp;20e siècle au&nbsp;Québec\u003C/em> ",artiste:{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"6XcRLkvl7SPbFEubWqDLeN",type:"Entry",createdAt:"2024-05-16T16:17:11.440Z",updatedAt:"2025-05-14T22:00:02.086Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:7,revision:3,contentType:{sys:{type:"Link",linkType:"ContentType",id:"artiste"}},locale:"fr-CA"},fields:{nom:"Berthe Des Clayes",id:"des-clayes--berthe",nomFamille:"Des Clayes",prenom:"Berthe",lieuDeNaissance:"Aberdeen, Écosse",anneeDeNaissance:1877,lieuDeDeces:"Devon, Angleterre",anneDeDeces:1968}},anneeDentreeAuMusee:1990,anneeEvenement:2009,annee:1900,anneeDeRealisation:"Undated",vignette:c,media:[c],fiche:{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"2EkV3csQNoIf12A9yAoQOW",type:"Asset",createdAt:"2025-05-16T16:02:29.968Z",updatedAt:"2025-06-02T17:04:59.220Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:6,revision:2,locale:"fr-CA"},fields:{title:"POL actions-collectives fiches 2009",description:"",file:{url:"//assets.ctfassets.net/nbfcd3ddu3u4/2EkV3csQNoIf12A9yAoQOW/bb68e1e810099983d7d0d4ccfb601824/POL_actions-collectives_fiches_2009.pdf",details:{size:103672},fileName:"POL_actions-collectives_fiches_2009.pdf",contentType:"application/pdf"}}},format:"Petit",hauteur:37.5,largeur:31.8,typologie:"peinture",medium:"Huile sur carton",droits:"© Succession Berthe Des Clayes.*\nPhoto : Stéfanie Meunier.",mention:"Don de Jacques Montplaisir",corps:{data:{},content:[{data:{},content:[{data:{},marks:[],value:"Présentée en deux temps au Musée national des beaux-arts du Québec en&nbsp;2009 et en&nbsp;2010, l’exposition ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Femmes artistes du 20",nodeType:"text"},{data:{},marks:[{type:"italic"},{type:"superscript"}],value:"e",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"siècle au Québec",nodeType:"text"},{data:{},marks:[],value:" représente un moment fort dans la mise en valeur de l’art des femmes. Cette manifestation a permis de présenter plus de 200&nbsp;œuvres et d’actualiser les connaissances à leur sujet. Sous le commissariat d’Esther Trépanier, le premier volet intitulé ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"La conquête d’un espace, 1900–1965",nodeType:"text"},{data:{},marks:[],value:", qui circule d’ailleurs jusqu’au Musée d’art de Joliette en&nbsp;2010, présente plusieurs œuvres issues de la première génération d’artistes du Québec qui aspiraient au statut professionnel, longtemps refusé aux femmes. ",nodeType:"text"}],nodeType:"paragraph"},{data:{},content:[{data:{},marks:[],value:"À cette génération d’oubliées appartient Berthe Des&nbsp;Clayes, mais aussi Georgina de L’Aubinière, Amelia Frederica Dyneley et Edith Hemming. Toutefois, aucune recherche approfondie n’existe sur la pratique des trois dernières, nées en Europe tout comme Des&nbsp;Clayes. ",nodeType:"text"}],nodeType:"paragraph"},{data:{},content:[{data:{},marks:[],value:"On en sait un peu plus sur Berthe Des Clayes, artiste formée d’abord à la Herkomer’s Art School en Angleterre, puis à l’Académie Julian à Paris. Elle expose à la Royal Academy of Arts de Londres entre&nbsp;1905 et&nbsp;1912, année où elle immigre à Montréal avec sa sœur Gertrude. Les sœurs s’installent au Beaver Hall Square, qui deviendra le foyer d’une importante communauté artistique dans les années&nbsp;1920",nodeType:"text"},{data:{},marks:[{type:"superscript"}],value:"1",nodeType:"text"},{data:{},marks:[],value:". ",nodeType:"text"}],nodeType:"paragraph"},{data:{},content:[{data:{},marks:[],value:"Des Clayes expose régulièrement à l’Académie royale des arts du Canada entre&nbsp;1923 et&nbsp;1947, et annuellement au Salon de l’Art Association of Montreal entre&nbsp;1912 et&nbsp;1941. Grâce à cette visibilité, elle connaît un succès auprès de la bourgeoisie et de la critique montréalaises. Jusqu’en&nbsp;1937, Des Clayes expose fréquemment en compagnie de ses sœurs, Gertrude et&nbsp;Alice",nodeType:"text"},{data:{},marks:[{type:"superscript"}],value:"2",nodeType:"text"},{data:{},marks:[],value:". ",nodeType:"text"}],nodeType:"paragraph"},{data:{},content:[{data:{},marks:[],value:"Sa production se résume à des paysages pittoresques peints dans un style proche de l’impressionnisme. Maîtrisant l’art de la composition, de la lumière et de la couleur, l'artiste s'exprime à partir d'une touche délicate et sûre.",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:" ",nodeType:"text"}],nodeType:"paragraph"},{data:{},content:[{data:{},marks:[{type:"italic"}],value:"L’écluse",nodeType:"text"},{data:{},marks:[],value:" consiste en un paysage riche en textures, mettant en scène, comme l’indique son titre, une écluse et des personnages vêtus de vestons et de chapeaux foncés. Rendant compte de l’interaction entre la nature et l’architecture, la composition est dominée par des rangées d’arbres peints dans des nuances de brun et de vert. La lumière trouve son chemin à travers les arbres alors que des personnages circulent sur les vantaux fermés de l’écluse. Les recherches réalisées sur ce tableau n’ont permis ni d’identifier le lieu peint ni d’attribuer une date à l’œuvre, car l’artiste séjournait en alternance entre le Canada et l’Écosse, son pays&nbsp;natal. ",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"document"},historique:{data:{},content:[{data:{},content:[{data:{},marks:[{type:"italic"}],value:"L'école des femmes",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:": 50",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"artistes canadiennes au Musée",nodeType:"text"},{data:{},marks:[],value:", Musée d’art de Joliette, Joliette (Québec), du 7&nbsp;septembre 2003 au 22&nbsp;février&nbsp;2004&nbsp;;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:" L’univers de Saint-Denys Garneau",nodeType:"text"},{data:{},marks:[],value:", Musée d’art de Joliette, Joliette (Québec), du 30&nbsp;janvier au 9&nbspavril 2000 [circulation&nbsp;: Centre national d'exposition à Jonquière, Jonquière (Québec), du 11&nbsp;août au 14&nbsp;octobre 2001&nbsp;; Centre culturel Yvonne L. Bombardier, Valcourt (Québec), du 15&nbsp;janvier au 15&nbsp;avril&nbsp;2001].",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"document"},publications:{data:{},content:[{data:{},content:[{data:{},marks:[],value:"France Gascon et Pascale Champagne,&nbsp;dir., ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"L'école des femmes",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:": 50",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"artistes canadiennes au Musée.  Guide d'exposition",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"/ The School of Women: 50",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Canadian Artists at the Museum. Guidebook to the Exhibit",nodeType:"text"},{data:{},marks:[],value:" (Joliette&nbsp;: Musée d'art de Joliette, 2003), 15&nbsp;; Alfred Laliberté, ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Les artistes de mon temps",nodeType:"text"},{data:{},marks:[],value:", texte établi, présenté et annoté par Odette Legendre (Montréal&nbsp;: Les Éditions du Boréal Express, 1986), 271. ",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"document"},credits:{data:{},content:[{data:{},content:[{data:{},content:[{data:{},content:[{data:{},marks:[],value:"Dorothy Farr et Natalie Luckyj, ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"From Women's Eyes: Women Painters in Canada",nodeType:"text"},{data:{},marks:[],value:" (Kingston&nbsp;: Agnes Etherington Art Centre, 1975), 31.",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"list-item"},{data:{},content:[{data:{},content:[{data:{},marks:[],value:"Esther Trépanier,&nbsp;dir., ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Femmes artistes du 20",nodeType:"text"},{data:{},marks:[{type:"italic"},{type:"superscript"}],value:"e",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"siècle au Québec ",nodeType:"text"},{data:{},marks:[],value:"&nbsp;",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:": œuvres du Musée national des beaux-arts du Québec",nodeType:"text"},{data:{},marks:[],value:" (Québec&nbsp;: Musée national des beaux-arts du Québec, 2010), 224.\n",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"list-item"}],nodeType:"ordered-list"},{data:{},content:[{data:{},marks:[],value:"\n\n\n* Dans le but de respecter ses obligations en matière de droits d’auteurs, le&nbsp;MAJ cherche à communiquer avec les ayants droit de l’artiste. Toute information pertinente à cet égard sera&nbsp;appréciée.",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"document"}}}]}},{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"6BUv3djJf0kLybZ9XnZI0E",type:"Entry",createdAt:"2024-02-12T21:12:24.765Z",updatedAt:"2025-05-23T18:07:12.662Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:143,revision:36,contentType:{sys:{type:"Link",linkType:"ContentType",id:"text"}},locale:"fr-CA"},fields:{id:"intro",corps:{data:{},content:[{data:{},content:[{data:{},content:[{data:{},content:[{data:{},content:[{data:{},marks:[],value:"Cette exposition propose une lecture féministe de 80&nbsp;ans d’existence du Musée d’art de Joliette&nbsp;(MAJ) à travers&nbsp;80 œuvres issues de la collection permanente. Elle fait contrepoids à la composition de la collection, qui ne compte aujourd’hui que 12&nbsp;% d’œuvres réalisées par des femmes. À l’image de la collection permanente, l’exposition rassemble des artistes principalement québécoises, mais pas&nbsp;exclusivement.",nodeType:"text"}],nodeType:"paragraph"},{data:{},content:[{data:{},marks:[],value:"Les récits qui en émergent se structurent à partir de trois frises chronologiques. La première retrace certaines transformations majeures entourant les conditions sociales et politiques des femmes ainsi que l’engagement politique des artistes du Québec et d’ailleurs. La deuxième mise sur les choix esthétiques et plastiques des femmes artistes à travers l’histoire de l’art. La troisième dresse une histoire des femmes propre au&nbsp;MAJ.",nodeType:"text"}],nodeType:"paragraph"},{data:{},content:[{data:{},marks:[],value:"La chronologie déployée débute en&nbsp;1942, alors que Louise Gadbois devient la première femme artiste à prendre part à la programmation du&nbsp;MAJ. Elle se termine en&nbsp;2022, année où les travaux de recherche en vue de cette exposition prenaient&nbsp;racine.",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"table-cell"},{data:{},content:[{data:{},content:[{data:{},marks:[{type:"bold"}],value:"Une chronologie anachronique\n",nodeType:"text"},{data:{},marks:[],value:"\nChaque œuvre de l’exposition est reliée à l’une des trois frises chronologiques, qui en oriente la lecture et en précise le contexte. Si certaines œuvres sont rattachées à leur année de création et disposées chronologiquement dans le temps, d’autres sont insérées de manière anachronique, en fonction d’un événement externe auquel elles sont associées, tel qu’une manifestation politique, une exposition importante ou le moment de leur&nbsp;acquisition.",nodeType:"text"}],nodeType:"paragraph"},{data:{},content:[{data:{},marks:[{type:"bold"}],value:"Une collection en évolution \n",nodeType:"text"},{data:{},marks:[],value:"\nLe contenu des frises, à l’instar de la collection dont elles rendent compte, n’est pas exhaustif; des angles morts s’y glissent. Comme toute collection muséale, celle du&nbsp;MAJ est marquée par des contraintes et des biais historiques. Cette mise en contexte permet d’exposer les partis pris de la collection, ainsi que les limitations et les omissions qu’elle comporte, aussi bien que la façon dont elle s’est construite. L’identification de ces paramètres constitue un nouveau pas vers une collection encore plus riche, diversifiée et représentative de la production des femmes&nbsp;artistes. ",nodeType:"text"}],nodeType:"paragraph"},{data:{},content:[{data:{},marks:[{type:"bold"}],value:"Des actions collectives\n",nodeType:"text"},{data:{},marks:[],value:"\nSi les femmes ont pris du galon à travers le temps, c’est qu’elles se sont engagées pour faire reconnaître leur valeur et mettre au jour les iniquités à leur égard. La population s’est mobilisée, des femmes se sont regroupées pour acquérir une force collective dans la sphère sociopolitique comme dans les arts. Elles ont su faire changer les perceptions et prendre leur place. Cette exposition ainsi que l’histoire de la collection dévoilée rendent visible ce travail collectif au fil du temps pour célébrer l’art au féminin, un travail d’ailleurs à poursuivre, car rien ne doit jamais être tenu pour&nbsp;acquis. ",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"table-cell"}],nodeType:"table-row"}],nodeType:"table"},{data:{},content:[{data:{},marks:[],value:"",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"document"}}}],credits:{data:{},content:[{data:{},content:[{data:{},content:[{data:{},content:[{data:{},content:[{data:{},marks:[{type:"bold"}],value:"Crédits des œuvres",nodeType:"text"},{data:{},marks:[],value:" \nprésentés par \nordre d’apparition",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"table-cell"},{data:{},content:[{data:{},content:[{data:{},marks:[],value:"",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"table-cell"},{data:{},content:[{data:{},content:[{data:{},marks:[{type:"bold"}],value:"Sorel Cohen, ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"The Camera Can Obliterate the Reality it Records",nodeType:"text"},{data:{},marks:[],value:", 1978, épreuve à développement chromogène, 15/100, 55,7 x 68,5&nbsp;cm. Don de Luc LaRochelle, 1996.019. ©&nbsp;Sorel Cohen. Photo&nbsp;: Stéfanie Meunier.",nodeType:"text"}],nodeType:"paragraph"},{data:{},content:[{data:{},marks:[{type:"bold"}],value:"Rita Letendre",nodeType:"text"},{data:{},marks:[],value:", ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"Étincelles",nodeType:"text"},{data:{},marks:[],value:", 1959, huile sur toile, 82,2 x 153,9&nbsp;cm. Collection Wilfrid Corbeil. Don des Clercs de Saint-Viateur du Canada, 2012.108. ©&nbsp;Succession Rita Letendre. Photo&nbsp;: Lucie Rocher.",nodeType:"text"}],nodeType:"paragraph"},{data:{},content:[{data:{},marks:[{type:"bold"}],value:"Berthe Des Clayes",nodeType:"text"},{data:{},marks:[],value:", ",nodeType:"text"},{data:{},marks:[{type:"italic"}],value:"L’écluse",nodeType:"text"},{data:{},marks:[],value:", non daté, huile sur carton, 31,8 x 37,5&nbsp;cm. Don de Jacques Montplaisir, 1990.035. ©&nbsp;Succession Berthe Des Clayes / Dans le but de respecter ses obligations en matière de droits d’auteurs, le MAJ cherche à communiquer avec les ayants droit de l’artiste. Toute information pertinente à cet égard sera appréciée. Photo&nbsp;:&nbsp;Stéfanie&nbsp;Meunier.",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"table-cell"}],nodeType:"table-row"}],nodeType:"table"},{data:{},content:[{data:{},marks:[],value:"",nodeType:"text"}],nodeType:"paragraph"}],nodeType:"document"}}},random:0,lignes:[{fields:{titre:"La société se transforme",id:"1-la-societe-se-transforme",couleur:"#BDB98D",logotype:{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"7oOLIXV4GR7P1zxHItVszl",type:"Asset",createdAt:"2024-02-23T15:56:46.363Z",updatedAt:"2025-05-07T19:36:28.297Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:12,revision:3,locale:"fr-CA"},fields:{title:"La société se transforme",description:"",file:{url:"//images.ctfassets.net/nbfcd3ddu3u4/7oOLIXV4GR7P1zxHItVszl/a6b1baaa626e0141f525dd4672bc6005/titre-ligne_la-socitete_FR_desktop.svg",details:{size:6464,image:{width:763,height:204}},fileName:"titre-ligne_la-socitete_FR_desktop.svg",contentType:"image/svg+xml"}}},lienVimeo:"https://www.youtube.com/embed/zXExYxkIRVw?si=89J-yCtN-w11teug",vignette:{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"3lauvdGu3pQdseqZjzNILJ",type:"Asset",createdAt:"2024-04-25T21:16:13.339Z",updatedAt:"2025-05-21T16:22:59.042Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:14,revision:4,locale:"fr-CA"},fields:{title:"Plan poitrine d'une femme assise devant u