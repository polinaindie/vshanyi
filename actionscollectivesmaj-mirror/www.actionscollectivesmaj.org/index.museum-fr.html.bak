<script>
(() => {
  const update = () => {
    document.querySelectorAll('.content figure.logo').forEach((fig) => {
      const h = Math.round(fig.getBoundingClientRect().height) || 898;
      fig.style.setProperty('--height', String(h));
      const progress = Math.min(1, Math.max(0, window.scrollY / (window.innerHeight || 1)));
      fig.style.setProperty('--scroll', String(progress));
    });
  };
  update();
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
})();
</script>

	</body>
</html>
