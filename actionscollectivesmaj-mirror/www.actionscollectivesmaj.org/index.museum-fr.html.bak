					]).then(([kit, app]) => {
						kit.start(app, element, {
							node_ids: [0, 2],
							data: [{type:"data",data:{lignes:[{fields:{titre:"La société se transforme",id:"1-la-societe-se-transforme",couleur:"#BDB98D"},sys:{id:"5GSyw84ZUJDRqearaThEMG",type:"Entry"}},{fields:{titre:"L’art se redéfinit",id:"2-lart-se-redefinit",couleur:"#BFCEE8"},sys:{id:"64ZSb08FT4KM3AIzx68FXn",type:"Entry"}},{fields:{titre:"Le Musée se construit",id:"3-le-musee-se-construit",couleur:"#F16261"},sys:{id:"5pJtvTCYAhgwKb4yTb3MmE",type:"Entry"}}],header:{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"60ZB0lERCBKeFQsm2vIfmi",type:"Entry",createdAt:"2024-03-05T22:03:46.565Z",updatedAt:"2024-05-01T20:18:13.312Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:15,revision:6,contentType:{sys:{type:"Link",linkType:"ContentType",id:"navigation"}},locale:"fr-CA"},fields:{titre:"Principale",id:"principale",liens:[{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"6IeprcZ7RARzZuPDvSm5CL",type:"Entry",createdAt:"2024-03-05T22:09:37.477Z",updatedAt:"2025-05-09T20:27:22.264Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:7,revision:3,contentType:{sys:{type:"Link",linkType:"ContentType",id:"lien"}},locale:"fr-CA"},fields:{titre:"À propos",route:"/pages/a-propos"}},{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"4QDWD2ASiHmHTwPTQ6aYNf",type:"Entry",createdAt:"2024-03-05T22:10:30.193Z",updatedAt:"2025-05-09T20:26:55.037Z",environment:{sys:{id:"master",type:"Link",linkType:"Environment"}},publishedVersion:13,revision:6,contentType:{sys:{type:"Link",linkType:"ContentType",id:"lien"}},locale:"fr-CA"},fields:{titre:"Exposition",route:"/#lignes",sousLiens:[{metadata:{tags:[],concepts:[]},sys:{space:{sys:{type:"Link",linkType:"Space",id:"nbfcd3ddu3u4"}},id:"1wsnMicXoh3m6Eu4bBzaD7",type:"Entry",createdAt:"2024-03-05T22:12:10.476Z",updatedAt:"2025-05-09T20:26:46.136